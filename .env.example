# Lead The Way — environment variables
# Copy to .env and fill in real values. Never commit .env to version control.

GEMINI_API_KEY=your-gemini-api-key-here

# PostgreSQL — writer role (used by ETL scripts only)
DATABASE_URL=postgresql+psycopg://ltw_writer:ltw_writer_secret@localhost:5432/leadtheway

# PostgreSQL — read-only role (used by Gemini agent — SELECT only)
DATABASE_URL_RO=postgresql+psycopg://ltw_agent:ltw_agent_secret@localhost:5432/leadtheway
