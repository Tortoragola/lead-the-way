# Lead The Way — environment variables
# 1. Copy this file:  cp .env.example .env
# 2. Fill in the values below.
# 3. Never commit .env to version control — it contains secrets.

# ── Gemini API ────────────────────────────────────────────────────────────────
# Get your free key at: https://aistudio.google.com/app/apikey
# Free-tier limits: gemini-3-flash = 5 RPM, gemini-3.1-flash-lite = 15 RPM
GEMINI_API_KEY=your-gemini-api-key-here

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL — found in Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co

# Anon/public key — safe to use in the app (respects Row Level Security)
# Found in Supabase Dashboard → Settings → API → Project API keys → anon public
SUPABASE_KEY=your-supabase-anon-key-here

# Service role key — only needed to run scripts/migrate_to_supabase.py (one-time ETL)
# Found in Supabase Dashboard → Settings → API → Project API keys → service_role
# Leave blank if you are not running the migration script.
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here
